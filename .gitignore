# ─────────────────────────────────────────────────────────────
#  Simple.sv · archivos que NO se versionan
# ─────────────────────────────────────────────────────────────

# ── Secretos y credenciales ──────────────────────────────────
# Nunca subas claves (ANTHROPIC_API_KEY va en ~/.zshrc, no en el repo)
privado/
.env
.env.*
!.env.example
*credenciales*
*.pem
*.key

# ── Sistema operativo ────────────────────────────────────────
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini

# ── Editores ─────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*~

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Node ─────────────────────────────────────────────────────
# Se reinstalan con `npm install` en cada proyecto que tenga package.json
node_modules
npm-debug.log*
yarn-error.log*

# ── Swift / Xcode (otros/FondoVivo) ──────────────────────────
.build/
.swiftpm/
otros/FondoVivo/build/
xcuserdata/
DerivedData/

# ── Logs y bitácoras en tiempo de ejecución ──────────────────
*.log
registros/*
!registros/.gitkeep

# ── Resultados generados ─────────────────────────────────────
pruebas/resultados_evaluacion.json
.playwright-mcp/

# ── Obsidian (estado local de la ventana) ────────────────────
**/.obsidian/workspace*.json
**/.obsidian/cache
.trash/
